@model IEnumerable<prjECommerceDemo.Models.TProduct>
@{
    ViewData["Title"] = "商品列表";
}

<h2 class="mb-3">商品列表</h2>

<!-- 搜尋表單 -->
@using (Html.BeginForm("List", "Product", FormMethod.Get))
{
    <div class="input-group mb-3">
        <input type="text" name="txtKeyword" class="form-control" placeholder="請輸入商品關鍵字"
               value="@Context.Request.Query["txtKeyword"]" />
        <button type="submit" class="btn btn-primary">查詢</button>
        <a href="@Url.Action("Create")" class="btn btn-success ms-2">新增商品</a>
    </div>
}

<!-- 商品表格 -->
<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>圖片</th>
            <th>商品名稱</th>
            <th>數量</th>
            <th>成本</th>
            <th>價格</th>
            <th>啟用</th>
            <th>功能</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.FImagePath))
                    {
                        <img src="~/images/@item.FImagePath" width="100" height="100" />
                    }
                    else
                    {
                        <span class="text-muted">無圖片</span>
                    }
                </td>
                <td>@item.FName</td>
                <td>@item.FQty</td>
                <td>@item.FCost</td>
                <td>@item.FPrice</td>
                <td>
                    <a asp-action="ToggleAvailable"
                       asp-route-id="@item.FId"
                       class="btn btn-sm @(item.FIsAvailable == true ? "btn-outline-success" : "btn-outline-secondary")"
                       onclick="return confirm('@(item.FIsAvailable == true ? "確定要下架此商品？" : "確定要重新上架此商品？")');">
                        @(item.FIsAvailable == true ? "上架中" : "已下架")
                    </a>
                </td>
                <td>
                    <a class="btn btn-sm btn-success"
                       href="@Url.Action("CopyAndCreate", "Product", new { id = item.FId })">
                        複製新增
                    </a>
                    <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", new { id = item.FId })">編輯</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = item.FId })"
                       onclick="return confirm('確定要刪除此商品？');">刪除</a>
                </td>
            </tr>
        }
    </tbody>
</table>


<!-- 分頁導覽 -->
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @{
            int currentPage = ViewBag.CurrentPage;
            int totalPages = ViewBag.TotalPages;
            string keyword = ViewBag.Keyword ?? "";
        }

        @if (currentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("List", new { page = currentPage - 1, txtKeyword = keyword })">« 上一頁</a>
            </li>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("List", new { page = i, txtKeyword = keyword })">@i</a>
            </li>
        }

        @if (currentPage < totalPages)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("List", new { page = currentPage + 1, txtKeyword = keyword })">下一頁 »</a>
            </li>
        }
    </ul>
</nav>
