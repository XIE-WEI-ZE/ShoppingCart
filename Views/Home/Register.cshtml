@model prjECommerceDemo.ViewModel.CRegisterViewModel

@{
    ViewData["Title"] = "會員註冊";
}

<h2 class="mb-4">會員註冊</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">@ViewBag.Message</div>
}

<form asp-action="Register" method="post">
    <div class="mb-3">
        <label asp-for="FName" class="form-label">姓名</label>
        <input asp-for="FName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FGender" class="form-label">性別</label>
        <select asp-for="FGender" class="form-select">
            <option value="">請選擇</option>
            <option value="男">男</option>
            <option value="女">女</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">生日</label>
        <div class="d-flex gap-2">
            <select asp-for="BirthYear" class="form-select">
                <option value="">-- 年 --</option>
                @for (int y = DateTime.Now.Year; y >= 1920; y--)
                {
                    <option value="@y">@y 年</option>
                }
            </select>
            <select asp-for="BirthMonth" class="form-select">
                <option value="">-- 月 --</option>
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">@m 月</option>
                }
            </select>
            <select asp-for="BirthDay" class="form-select">
                <option value="">-- 日 --</option>
                @for (int d = 1; d <= 31; d++)
                {
                    <option value="@d">@d 日</option>
                }
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="FPhone" class="form-label">電話</label>
        <input asp-for="FPhone" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FEmail" class="form-label">Email</label>
        <input asp-for="FEmail" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FAccount" class="form-label">帳號</label>
        <input asp-for="FAccount" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FPassword" class="form-label">密碼</label>
        <input asp-for="FPassword" class="form-control" type="password" />
    </div>

    <div class="mb-3">
        <label asp-for="FCity" class="form-label">縣市</label>
        <input asp-for="FCity" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FDistrict" class="form-label">地區</label>
        <input asp-for="FDistrict" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FRoadAddress" class="form-label">詳細地址</label>
        <input asp-for="FRoadAddress" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">送出註冊</button>
    <a asp-action="Login" class="btn btn-outline-secondary ms-2">已有帳號？登入</a>
</form>
