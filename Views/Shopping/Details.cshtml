@model prjECommerceDemo.ViewModel.CProductWrap
@{
    ViewData["Title"] = "商品詳情";
}

<h2 class="mb-4">商品詳細資訊</h2>

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.FImagePath))
        {
            <img src="~/images/@Model.FImagePath" class="img-fluid" />
        }
        else
        {
            <div class="text-muted">無圖片</div>
        }
    </div>

    <div class="col-md-7">
        <h3 class="fw-bold">@Model.FName</h3>
        <p class="text-danger fs-4">售價：NT$ @Model.FPrice?.ToString("N0")</p>
        <p>@Model.FDescription</p>

        <form asp-action="AddToCart" method="post">
            <input type="hidden" name="txtFId" value="@Model.FId" />
            <div class="mb-3">
                <label class="form-label">數量</label>
                <input type="number" name="txtCount" value="1" class="form-control" min="1" />
            </div>
            <button type="submit" class="btn btn-primary">加入購物車</button>
            <a asp-action="List" class="btn btn-secondary">返回商城</a>
        </form>
    </div>
</div>
