@model prjECommerceDemo.ViewModel.CProductWrap
@{
    ViewData["Title"] = "新增商品";
}

<h2>新增商品</h2>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="FName"></label>
                <input asp-for="FName" class="form-control" />
                <span asp-validation-for="FName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FQty"></label>
                <input asp-for="FQty" class="form-control" />
                <span asp-validation-for="FQty" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FCost"></label>
                <input asp-for="FCost" class="form-control" />
                <span asp-validation-for="FCost" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FPrice"></label>
                <input asp-for="FPrice" class="form-control" />
                <span asp-validation-for="FPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FDescription"></label>
                <textarea asp-for="FDescription" class="form-control"></textarea>
                <span asp-validation-for="FDescription" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>商品圖片</label>
                <input type="file" asp-for="photo" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="新增商品" class="btn btn-success" />
                <a asp-action="List" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
